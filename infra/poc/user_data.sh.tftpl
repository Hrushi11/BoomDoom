#!/usr/bin/env bash
# First boot: install Docker + Compose, write the stack, start it, and keep it on the newest image.
set -euxo pipefail
dnf install -y docker
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL "https://github.com/docker/compose/releases/download/v2.30.3/docker-compose-linux-x86_64" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose
systemctl enable --now docker

mkdir -p /opt/boomdoom/pgdata /opt/boomdoom/caddy
cat > /opt/boomdoom/host.env <<HOSTENV
AWS_REGION=${region}
ENV_PARAM=${env_param}
GHCR_PARAM=${ghcr_param}
GHCR_USER=${github_user}
BOOMDOOM_IMAGE=${image}
API_HOST=${api_host}
HOSTENV
echo "${compose_b64}" | base64 -d > /opt/boomdoom/docker-compose.yml
echo "${boot_b64}" | base64 -d > /opt/boomdoom/boot.sh

# boot.sh is idempotent: fetch secrets, pull the image, (re)create only what changed.
cat > /etc/systemd/system/boomdoom.service <<UNIT
[Unit]
Description=BoomDoom POC stack (pull + up)
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/boomdoom/boot.sh
UNIT

# Continuous deployment: GitHub Actions pushes :latest, this picks it up within ~2 minutes.
cat > /etc/systemd/system/boomdoom.timer <<UNIT
[Unit]
Description=Pull and apply the newest BoomDoom image

[Timer]
OnBootSec=30s
OnUnitActiveSec=2min

[Install]
WantedBy=timers.target
UNIT

systemctl daemon-reload
systemctl enable --now boomdoom.timer
