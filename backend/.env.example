# Copy to .env for local development. Real secrets live in AWS Secrets Manager (Tech Spec §9.2).
BOOMDOOM_ENV=local
DATABASE_URL=postgresql+psycopg://boomdoom:boomdoom@localhost:5432/boomdoom
# Leave empty locally to use the in-process queue instead of SQS.
SQS_SCRIPT_JOBS_URL=
SQS_RENDER_JOBS_URL=
SQS_DELETION_JOBS_URL=
AWS_REGION=ap-south-1
LESSONS_BUCKET=boomdoom-lessons-local
CDN_BASE_URL=http://localhost:8000/static
# JWT RS256 keys (PEM). If empty in local env, an ephemeral key pair is generated at startup.
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
OPENAI_API_KEY=
OPENAI_MODEL_SYLLABUS=gpt-6.2-sol
OPENAI_MODEL_SCRIPT=gpt-6.1-terra
OPENAI_MODEL_QA=gpt-6-luna
OPENAI_DAILY_COST_CAP_USD=20
