# BoomDoom backend settings. Copy to backend/.env. Every value has a working default for local runs:
# `python scripts/run_local.py --mock` needs NOTHING from this file (it overrides the database, queue, storage and keys).
# On the AWS POC, Terraform writes the real values to SSM (infra/poc).

# ---- Environment -------------------------------------------------------------------------------------------------
BOOMDOOM_ENV=local                 # local | test | demo | dev | prod (prod hides /docs)
LOG_LEVEL=INFO

# ---- Database + queue + storage (run_local.py sets these for you) ------------------------------------------------
DATABASE_URL=postgresql+psycopg://boomdoom:boomdoom@localhost:5432/boomdoom
QUEUE_BACKEND=db                   # "db" (Postgres-backed; local + POC) or "sqs"
STORAGE_BACKEND=local              # "local" (served at /static) or "s3" (presigned URLs, or CloudFront if configured)
LOCAL_STORAGE_DIR=./.data/storage
CDN_BASE_URL=http://localhost:8000/static
LESSONS_BUCKET=
AWS_REGION=ap-south-1

# ---- Auth ----------------------------------------------------------------------------------------------------------
# JWT RS256 keys. Empty in local/test = keys are created for you (run_local.py keeps them in .data/jwt).
# Generate for a server: python scripts/gen_keys.py >> .env
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=

# ---- LLM (lesson syllabi and scripts) ------------------------------------------------------------------------------
# LLM_MODE: auto = OpenAI when OPENAI_API_KEY is set, otherwise the mock;  mock = templated lessons, no key, no cost;
#           openai = always OpenAI.
LLM_MODE=auto
OPENAI_API_KEY=                    # only needed for real (non-templated) lessons and for RENDERER=film
OPENAI_DAILY_COST_CAP_USD=10       # OpenAI calls stop for the day at this spend; jobs wait and retry
OPENAI_MODEL_SYLLABUS=gpt-6.2-sol
OPENAI_MODEL_SCRIPT=gpt-6.2-sol
OPENAI_MODEL_QA=gpt-6-luna

# ---- Rendering -----------------------------------------------------------------------------------------------------
# placeholder = ffmpeg title card with timed silence (no extra installs; used by --mock)
# film        = the stickman film director (needs OPENAI_API_KEY, Playwright Chromium, Kokoro voice; see AGENTS.md)
# stickman    = the older Stickman Studio renderer (needs the Studio checkout)
RENDERER=placeholder
FFMPEG_BIN=ffmpeg                  # run_local.py uses the bundled imageio-ffmpeg binary
STICKMAN_SKILL_DIR=                # film renderer: <repo>/vendor/stickman-skill
STICKMAN_STUDIO_DIR=               # film + stickman renderers: <repo>/vendor/stickman-studio (voice + compose)
STICKMAN_MODELS_DIR=               # Kokoro voice model files (kokoro-v1.0.int8.onnx, voices-v1.0.bin)
OPENAI_MODEL_FILM=gpt-6.2-sol
FILM_VOICE_ID=af_heart
FILM_RENDER_JOBS=0                 # parallel Chromium renderers per film (0 = default)
FILM_REVIEW_ROUNDS=1               # vision reviews of the film's stills (~2 min each)

# ---- Operator tools ------------------------------------------------------------------------------------------------
# /trackVideoGen (live generation tracker) and /v1/admin/* (queue controls) exist only when one of these is set.
ADMIN_PASSWORD=boomdoom-admin      # sign-in for /trackVideoGen (run_local.py defaults to boomdoom-admin)
ADMIN_TOKEN=                       # X-Admin-Token header for scripts

# ---- Product limits ------------------------------------------------------------------------------------------------
TARGET_STOCK=5                     # ready lessons kept per topic
REFILL_BELOW=3
FREE_LESSONS_PER_DAY=20
FREE_TOPICS_PER_DAY=10
REQUESTS_PER_MINUTE=30

# ---- Optional (off when empty) -------------------------------------------------------------------------------------
FCM_SERVICE_ACCOUNT_JSON=          # push notifications when lessons are ready
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY_PEM=
COGNITO_USER_POOL_ID=              # optional account login (P1)
COGNITO_APP_CLIENT_ID=
