# Local development. On the POC host, Terraform writes the real values to SSM (infra/poc).
BOOMDOOM_ENV=local
DATABASE_URL=postgresql+psycopg://boomdoom:boomdoom@localhost:5432/boomdoom

# Queue: "db" (Postgres-backed; local + POC) or "sqs"
QUEUE_BACKEND=db
# Storage: "local" (served at /static) or "s3" (presigned URLs, or CloudFront if configured)
STORAGE_BACKEND=local
LESSONS_BUCKET=
AWS_REGION=ap-south-1

# JWT RS256 keys. Empty in local/test = ephemeral keys. Generate: python scripts/gen_keys.py >> .env
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=

# Required for the script worker
OPENAI_API_KEY=
OPENAI_DAILY_COST_CAP_USD=10

# Rendering: "placeholder" (ffmpeg only) or "stickman" (needs the Stickman Studio fork installed)
RENDERER=placeholder

# Optional
FCM_SERVICE_ACCOUNT_JSON=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY_PEM=
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
